# SmartRail — Real Hardware Configuration Template
# ==============================================================================
# ESP32 Railway Monitor Base URL (serves GET /data)
# Replace YOUR_ESP32_IP with the IP address displayed by the ESP32 Serial Monitor tomorrow.
# Example: http://192.168.1.105
# ==============================================================================
VITE_ESP32_API_URL=http://YOUR_ESP32_IP

# ESP32-CAM Live MJPEG Stream URL (serves GET /stream)
# Replace YOUR_CAM_IP with the IP address displayed by the ESP32-CAM Serial Monitor tomorrow.
# Example: http://192.168.1.106/stream
VITE_ESP32_CAM_URL=http://YOUR_CAM_IP/stream

# Dashboard Polling Interval in milliseconds (1000ms = 1 second)
VITE_POLL_INTERVAL_MS=1000

# Sensor Mock Flag (MUST remain false for real hardware testing)
VITE_ENABLE_SENSOR_MOCK=false
